# .env is bundled into the app as an asset, so `flutter run` fails with an
# "unable to find asset" error if it is missing — copy it first.
#
# Precedence, highest wins:
#   1. --dart-define=API_BASE_URL=...   (compile time, overrides everything)
#   2. API_BASE_URL in this file        (runtime)
#   3. built-in fallback                (http://localhost:8000, or
#                                        http://10.0.2.2:8000 on Android)

# ---------------------------------------------------------------------------

# Deployed API.
#API_BASE_URL=http://201.18.206.58:8000

#   Android emulator (10.0.2.2 is the host machine, never localhost):
# API_BASE_URL=http://10.0.2.2:8000
#
#   Physical device over USB — run `adb reverse tcp:8000 tcp:8000` first:
# API_BASE_URL=http://localhost:8000
#
#   Web, desktop or iOS simulator:
# API_BASE_URL=http://localhost:8000
