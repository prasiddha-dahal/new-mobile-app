<?xml version="1.0" encoding="utf-8"?>
<!--
  Release network policy.

  The app targets API 36, where Android blocks plaintext HTTP by default. The
  backend is currently served over plain http from a bare IP, so that one host
  is allowed to speak cleartext and everything else keeps the default
  HTTPS-only policy.

  Remove this exception once the API sits behind TLS. The debug build has its
  own, wider policy in src/debug/res/xml/network_security_config.xml, which
  overrides this file there.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">187.126.117.12</domain>
    </domain-config>
</network-security-config>
