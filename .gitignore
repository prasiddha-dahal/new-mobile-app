**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

#AGENTS FILES
AGENTS.md
.agents/
skills-lock.json

#Design file
sahayatri-care-connect-main/

# Generated stubs (build_runner incompatible)
lib/features/auth/data/datasources/auth_api.g.dart
lib/features/auth/data/models/auth_models.g.dart

# Runtime environment config. Committed as .env.example instead —
# copy that to .env locally. Keeps per-developer API targets (and any
# credentials added later) out of the repo.
.env
.env.local
.env.*.local
!.env.example

# Code-generation output. Regenerate with:
#   dart run build_runner build --delete-conflicting-outputs
*.g.dart
*.freezed.dart

# gen-l10n output. Regenerated by `flutter pub get` (pubspec sets
# `generate: true`), so CI rebuilds it from the .arb files on every run —
# the .arb files are the source of truth, these are not.
lib/l10n/generated/
lib/l10n/untranslated.txt

# Golden-test failure artefacts. `flutter test` writes master/test/diff PNGs
# beside the goldens when one fails; they are debugging output, not fixtures,
# and a stale set had been committed.
test/**/failures/
